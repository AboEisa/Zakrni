<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Zakrni" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:layoutDirection">ltr</item>
        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        
        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        
        <!-- Tertiary Colors -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        
        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        
        <!-- Error Colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        
        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">#1A3C34</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Theme.Zakrni" parent="Base.Theme.Zakrni" />

    <!-- Custom Bottom Navigation Style -->
    <style name="CustomBottomNavigationStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bottom_nav_background</item>
        <item name="itemActiveIndicatorStyle">@style/CustomActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:maxHeight">36dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemIconSize">0dp</item>
        <item name="itemIconTint">@android:color/transparent</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationTextActive</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationTextInactive</item>
    </style>

    <!-- Text styles for navigation -->
    <style name="BottomNavigationTextActive" parent="@style/TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#D4AF37</item>
    </style>

    <style name="BottomNavigationTextInactive" parent="@style/TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Active indicator -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#30D4AF37</item>
        <item name="android:width">75dp</item>
        <item name="android:height">32dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <!-- ===================== AUDIO PLAYER STYLES ===================== -->
    
    <!-- Audio Player Card Style -->
    <style name="AudioPlayerCardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/player_background</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">8dp</item>
    </style>

    <!-- Audio Player Button Style -->
    <style name="AudioPlayerButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/player_button_icon</item>
        <item name="backgroundTint">@color/player_button_background</item>
        <item name="shapeAppearance">@style/CircleButtonShape</item>
    </style>

    <style name="CircleButtonShape" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Audio Player SeekBar Style -->
    <style name="AudioPlayerSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressTint">@color/player_progress</item>
        <item name="android:progressBackgroundTint">@color/player_progress_track</item>
        <item name="android:thumbTint">@color/player_thumb</item>
    </style>

    <!-- Audio Time Text Style -->
    <style name="AudioTimeText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/player_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ===================== RECITER SELECTION STYLES ===================== -->
    
    <!-- Reciter Bottom Sheet Style -->
    <style name="ReciterBottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ReciterBottomSheetShape</item>
    </style>

    <style name="ReciterBottomSheetShape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Reciter Item Style -->
    <style name="ReciterItemStyle" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/reciter_item_background</item>
        <item name="strokeColor">@color/reciter_item_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="android:layout_marginVertical">4dp</item>
    </style>

    <!-- Reciter Item Selected Style -->
    <style name="ReciterItemSelectedStyle" parent="ReciterItemStyle">
        <item name="cardBackgroundColor">@color/reciter_item_selected</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- ===================== QURAN HEADER STYLES ===================== -->
    
    <style name="QuranHeaderStyle">
        <item name="android:background">@color/quran_header</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="QuranHeaderTitleStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/quran_header_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QuranHeaderSubtitleStyle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/player_text_secondary</item>
    </style>

    <!-- ===================== DIALOG STYLES ===================== -->
    
    <style name="CustomAlertDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">16dp</item>
        <item name="colorSurface">@color/surface</item>
    </style>

    <!-- Reciter Bottom Sheet Dialog Style -->
    <style name="ReciterBottomSheetDialogStyle" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ReciterBottomSheetModalStyle</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="ReciterBottomSheetModalStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ReciterBottomSheetShape</item>
    </style>

    <!-- Side Sheet Dialog Style -->
    <style name="SideSheetDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Side Sheet Animation -->
    <style name="SideSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Prayer Alert Activity Theme -->
    <style name="Theme.PrayerAlert" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:layoutDirection">ltr</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="colorPrimary">#FFD700</item>
        <item name="colorOnPrimary">#1A1A2E</item>
    </style>

</resources>
