<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Zakrni" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Zakrni" parent="Base.Theme.Zakrni" />

    <!-- Custom Bottom Navigation Style -->
    <style name="CustomBottomNavigationStyle" parent="Widget.Material3.BottomNavigationView">
        <!-- Brown background with rounded corners -->
        <item name="android:background">@drawable/bottom_nav_background</item>
        <!-- Selected item background -->
        <item name="itemActiveIndicatorStyle">@style/CustomActiveIndicator</item>
        <!-- Force labels to be always visible -->
        <item name="labelVisibilityMode">labeled</item>
        <!-- Remove elevation -->
        <item name="elevation">0dp</item>
        <!-- Height matching your image exactly -->
        <item name="android:minHeight">44dp</item>
        <!-- Padding to ensure text fits -->
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <!-- Remove ripple effect -->
        <item name="itemRippleColor">@android:color/transparent</item>
        <!-- Force icon removal -->
        <item name="itemIconSize">0dp</item>
        <item name="itemIconTint">@android:color/transparent</item>
    </style>

    <!-- Active indicator matching your image shape -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#CC9B76</item>
        <item name="android:width">80dp</item>
        <item name="android:height">28dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>