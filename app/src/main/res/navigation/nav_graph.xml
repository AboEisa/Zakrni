<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/allCategoriesFragment">

    <fragment
        android:id="@+id/allCategoriesFragment"
        android:name="com.example.zakrni.clean.ui.views.AllCategoriesFragment"
        android:label="fragment_all_categories"
        tools:layout="@layout/fragment_all_categories">

        <action
            android:id="@+id/action_allCategoriesFragment_to_allMediaFragment"
            app:destination="@id/allMediaFragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_allCategoriesFragment_to_playerTimesFragment"
            app:destination="@id/playerTimesFragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_allCategoriesFragment_to_hadithFragment"
            app:destination="@id/hadithFragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_allCategoriesFragment_to_duaFragment"
            app:destination="@id/duaFragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_allCategoriesFragment_to_azkarFragment"
            app:destination="@id/azkarFragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_allCategoriesFragment_to_allahNamesFragment"
            app:destination="@id/allahNamesFragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_allCategoriesFragment_to_tasbehFragment"
            app:destination="@id/tasbehFragment"
            app:launchSingleTop="true" />
        <action
            android:id="@+id/action_allCategoriesFragment_to_quran2Fragment"
            app:destination="@id/quran2Fragment" />
    </fragment>

    <!-- Other fragments remain the same -->
    <fragment
        android:id="@+id/allMediaFragment"
        android:name="com.example.zakrni.clean.ui.views.AllMediaFragment"
        android:label="fragment_all_media"
        tools:layout="@layout/fragment_all_media" />

    <fragment
        android:id="@+id/playerTimesFragment"
        android:name="com.example.zakrni.clean.ui.views.PrayerTimesFragment"
        android:label="fragment_player_times"
        tools:layout="@layout/fragment_prayer_times" />

    <fragment
        android:id="@+id/hadithFragment"
        android:name="com.example.zakrni.clean.ui.views.HadithFragment"
        android:label="الأحاديث"
        tools:layout="@layout/fragment_hadith" />

    <fragment
        android:id="@+id/duaFragment"
        android:name="com.example.zakrni.clean.ui.views.DuaFragment"
        android:label="الأدعية"
        tools:layout="@layout/fragment_dua" />

    <fragment
        android:id="@+id/azkarFragment"
        android:name="com.example.zakrni.clean.ui.views.AzkarFragment"
        android:label="الأذكار"
        tools:layout="@layout/fragment_azkar" />

    <fragment
        android:id="@+id/allahNamesFragment"
        android:name="com.example.zakrni.clean.ui.views.AllahNamesFragment"
        android:label="أسماء الله الحسنى"
        tools:layout="@layout/fragment_allah_names" />

    <fragment
        android:id="@+id/tasbehFragment"
        android:name="com.example.zakrni.clean.ui.views.TasbehFragment"
        android:label="التسبيح"
        tools:layout="@layout/fragment_tasbeh" />


    <fragment
        android:id="@+id/quranFragment"
        android:name="com.example.zakrni.clean.ui.views.QuranFragment"
        tools:layout="@layout/fragment_quran">
        <argument
            android:name="surahNumber"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/quran2Fragment"
        android:name="com.example.zakrni.clean.ui.views.Quran2Fragment"
        tools:layout="@layout/fragment_quran2">
        <action
            android:id="@+id/action_quran2Fragment_to_quranFragment"
            app:destination="@id/quranFragment">
            <argument
                android:name="surahNumber"
                app:argType="integer" />
        </action>
    </fragment>

    <!-- Add to nav_graph.xml -->
    <fragment
        android:id="@+id/articlesFragment"
        android:name="com.example.zakrni.clean.ui.views.ArticlesFragment"
        android:label="المقالات"
        tools:layout="@layout/fragment_articles" />

    <fragment
        android:id="@+id/radioFragment"
        android:name="com.example.zakrni.clean.ui.views.RadioFragment"
        android:label="الإذاعة"
        tools:layout="@layout/fragment_radio" />

    <fragment
        android:id="@+id/videosFragment"
        android:name="com.example.zakrni.clean.ui.views.VideosFragment"
        android:label="الفيديوهات"
        tools:layout="@layout/fragment_videos" />

    <fragment
        android:id="@+id/recitersFragment"
        android:name="com.example.zakrni.clean.ui.views.RecitersFragment"
        android:label="القراء"
        tools:layout="@layout/fragment_reciters" />

    <!-- Add navigation actions from AllCategoriesFragment -->
    <action
        android:id="@+id/action_allCategoriesFragment_to_articlesFragment"
        app:destination="@id/articlesFragment" />

    <action
        android:id="@+id/action_allCategoriesFragment_to_radioFragment"
        app:destination="@id/radioFragment" />

    <action
        android:id="@+id/action_allCategoriesFragment_to_videosFragment"
        app:destination="@id/videosFragment" />

    <action
        android:id="@+id/action_allCategoriesFragment_to_recitersFragment"
        app:destination="@id/recitersFragment" />

</navigation>