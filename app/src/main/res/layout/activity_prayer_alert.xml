<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_alert_bg"
    android:fitsSystemWindows="false">

    <!-- Background Gradient Overlay (kept for binding) -->
    <View
        android:id="@+id/gradientOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Animated Decorative Circles - soft glow -->
    <View
        android:id="@+id/decorCircle1"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:alpha="0.04"
        android:background="@drawable/prayer_alert_icon_ring"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="-100dp"
        android:layout_marginBottom="-40dp" />

    <View
        android:id="@+id/decorCircle2"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.03"
        android:background="@drawable/prayer_alert_icon_ring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="-60dp"
        android:layout_marginTop="80dp" />

    <!-- Main Content (no scroll, aligned upward) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/close_btn_circle"
            android:contentDescription="@string/prayer_alert_close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/prayer_text_white_80" />

        <LinearLayout
            android:id="@+id/topContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/buttonsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnClose"
            app:layout_constraintVertical_bias="0">

            <!-- Icon Ring - NO CardView, just FrameLayout -->
            <FrameLayout
                android:id="@+id/iconCard"
                android:layout_width="90dp"
                android:layout_height="90dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/prayer_alert_icon_ring" />

                <ImageView
                    android:id="@+id/ivPrayerIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_prayer"
                    app:tint="@color/islamic_gold" />

            </FrameLayout>

            <!-- Gold accent dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/prayer_alert_icon_ring" />

            <!-- Prayer Label -->
            <TextView
                android:id="@+id/tvPrayerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="@string/prayer_alert_label"
                android:textColor="@color/prayer_text_white_80"
                android:textSize="13sp" />

            <!-- Prayer Name Arabic -->
            <TextView
                android:id="@+id/tvPrayerNameArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:text="@string/prayer_alert_default_prayer_name_ar_display"
                android:textColor="@color/prayer_text_white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Prayer Name English -->
            <TextView
                android:id="@+id/tvPrayerNameEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.2"
                android:text="@string/prayer_alert_default_prayer_name_en_display"
                android:textColor="@color/prayer_text_white_50"
                android:textSize="12sp" />

            <!-- Time Section - flat, no CardView -->
            <LinearLayout
                android:id="@+id/timeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/prayer_alert_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/prayer_alert_time_now"
                    android:textColor="@color/prayer_text_white_60"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:autoSizeMaxTextSize="38sp"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.03"
                    android:text="@string/prayer_alert_default_time"
                    android:textColor="@color/islamic_gold"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/prayer_text_white_20" />

                <TextView
                    android:id="@+id/tvCurrentDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_alert_default_date"
                    android:textColor="@color/prayer_text_white_70"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Quran Verse Section - flat, no CardView -->
            <LinearLayout
                android:id="@+id/verseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/prayer_alert_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <!-- Gold accent bar -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/gold_accent_bar" />

                <TextView
                    android:id="@+id/tvQuranVerse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.35"
                    android:maxLines="2"
                    android:text="@string/prayer_alert_default_verse"
                    android:textColor="@color/prayer_text_white_c0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvQuranVerseReference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.05"
                    android:text="@string/prayer_alert_default_verse_reference"
                    android:textColor="@color/prayer_text_white_40"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/buttonsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenApp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/prayer_alert_open_app"
                android:textColor="@color/prayer_action_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/islamic_gold"
                app:cornerRadius="24dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_apps"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/prayer_action_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismiss"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_outline_subtle"
                android:text="@string/prayer_alert_close"
                android:textColor="@color/prayer_text_white_70"
                android:textSize="14sp"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="22dp"
                app:rippleColor="@color/prayer_text_white_20"
                app:strokeColor="@color/prayer_text_white_30"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
