<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#FEFBF4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:id="@+id/icon_location"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القاهرة، مصر"
                android:textSize="14sp"
                android:textColor="#333333"
                app:layout_constraintStart_toEndOf="@id/icon_location"
                app:layout_constraintTop_toTopOf="@id/icon_location"
                app:layout_constraintBottom_toBottomOf="@id/icon_location"
                android:layout_marginStart="6dp"/>

            <ImageView
                android:id="@+id/icon_calendar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_date_hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الثلاثاء 12 ديسمبر 2024"
                android:textSize="12sp"
                android:textColor="#999999"
                app:layout_constraintTop_toTopOf="@id/icon_calendar"
                app:layout_constraintBottom_toBottomOf="@id/icon_calendar"
                app:layout_constraintEnd_toStartOf="@id/icon_calendar"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_date_gregorian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الثلاثاء 12 ديسمبر 2024"
                android:textSize="14sp"
                android:textColor="#795547"
                app:layout_constraintTop_toBottomOf="@id/tv_date_hijri"
                app:layout_constraintEnd_toEndOf="@id/tv_date_hijri"
                android:layout_marginTop="2dp"/>

            <View
                android:id="@+id/clock_background"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/location_background"
                app:layout_constraintTop_toBottomOf="@id/tv_location"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="1.0"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/clock_circle"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/selected_nav_background"
                app:layout_constraintTop_toTopOf="@id/clock_background"
                app:layout_constraintStart_toStartOf="@id/clock_background"
                app:layout_constraintEnd_toEndOf="@id/clock_background"
                android:layout_marginTop="30dp"/>

            <ImageView
                android:id="@+id/icon_clock"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_clock"
                app:layout_constraintTop_toTopOf="@id/clock_circle"
                app:layout_constraintBottom_toBottomOf="@id/clock_circle"
                app:layout_constraintStart_toStartOf="@id/clock_circle"
                app:layout_constraintEnd_toEndOf="@id/clock_circle"/>

            <TextView
                android:id="@+id/tv_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-04:55"
                android:textSize="32sp"
                android:textColor="#8B4513"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/clock_circle"
                app:layout_constraintStart_toStartOf="@id/clock_background"
                app:layout_constraintEnd_toEndOf="@id/clock_background"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tv_next_prayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الوقت المتبقي\nلصلاة الظهر"
                android:textSize="14sp"
                android:textColor="#999999"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                app:layout_constraintTop_toBottomOf="@id/tv_remaining"
                app:layout_constraintStart_toStartOf="@id/clock_background"
                app:layout_constraintEnd_toEndOf="@id/clock_background"
                app:layout_constraintBottom_toBottomOf="@id/clock_background"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="الوقت المتبقي"
                android:textColor="#A1A1A1"
                app:layout_constraintStart_toEndOf="@+id/tv_remaining"
                app:layout_constraintTop_toTopOf="@+id/tv_remaining" />

            <TextView
                android:id="@+id/tv_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" لصلاة الظهر"
                android:textColor="#CC9B76"
                android:layout_marginStart="@dimen/_8sdp"
                app:layout_constraintStart_toEndOf="@+id/tv_remaining"
                app:layout_constraintTop_toBottomOf="@+id/textView3" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Add this to your existing layout -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>