<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/articleImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/article_placeholder"
            app:cardCornerRadius="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/articleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="أحكام الحجارة"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5D4E37"
                android:fontFamily="@font/scheherazade"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/articleDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مادة مرئية مميزة تتعلق بأحكام الحجارة والأحكام والأصول والفقه من الأحكام والفقه في قضايا..."
                android:textSize="14sp"
                android:textColor="#888888"
                android:fontFamily="@font/scheherazade"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/articleDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="منذ 3 أيام"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA" />

                <TextView
                    android:id="@+id/articleViews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 1.2k مشاهدة"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>