<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".clean.ui.views.AllCategoriesFragment">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- First Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="12dp">

                <!-- Allah Names -->
                <LinearLayout
                    android:id="@+id/allahNamesFragment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selected_nav_background"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="100dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_allah_names"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/layout_localized_004"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_localized_004"
                        android:textSize="12sp"
                        android:textColor="@color/brand_dark"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <!-- Tasbeh -->
                <LinearLayout
                    android:id="@+id/tasbehFragment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selected_nav_background"
                    android:padding="12dp"
                    android:layout_marginHorizontal="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="100dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_tasbeh"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/layout_localized_036"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_localized_036"
                        android:textSize="12sp"
                        android:textColor="@color/brand_dark"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <!-- Dua -->
                <LinearLayout
                    android:id="@+id/duaFragment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selected_nav_background"
                    android:padding="12dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="100dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_dua"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/layout_localized_032"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_localized_032"
                        android:textSize="12sp"
                        android:textColor="@color/brand_dark"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Second Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Hadith -->
                <LinearLayout
                    android:id="@+id/hadithFragment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selected_nav_background"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="100dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_hadith"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/layout_localized_031"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_localized_031"
                        android:textSize="12sp"
                        android:textColor="@color/brand_dark"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <!-- Azkar -->
                <LinearLayout
                    android:id="@+id/azkarFragment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selected_nav_background"
                    android:padding="12dp"
                    android:layout_marginHorizontal="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="100dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_azkar"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/layout_localized_033"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_localized_033"
                        android:textSize="12sp"
                        android:textColor="@color/brand_dark"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <!-- Quran -->
                <LinearLayout
                    android:id="@+id/quranFragment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/selected_nav_background"
                    android:padding="12dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="100dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_quran"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/layout_localized_055"
                        android:scaleType="centerInside" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/layout_localized_055"
                        android:textSize="12sp"
                        android:textColor="@color/brand_dark"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>