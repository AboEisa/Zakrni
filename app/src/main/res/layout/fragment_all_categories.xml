<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".clean.ui.views.AllCategoriesFragment">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_15sdp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- First Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="@dimen/_15sdp">

            <LinearLayout
                android:id="@+id/allahNamesFragment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selected_nav_background"
                android:padding="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/_80sdp">

                <ImageView
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_allah_names"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:contentDescription="أسماء الله الحسنى" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أسماء الله الحسنى"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tasbehFragment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selected_nav_background"
                android:padding="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/_80sdp">

                <ImageView
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_tasbeh"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:contentDescription="التسبيح الذكر" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التسبيح الذكر"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/duaFragment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selected_nav_background"
                android:padding="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/_80sdp">

                <ImageView
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_dua"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:contentDescription="الادعية" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الادعية"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Second Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/hadithFragment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selected_nav_background"
                android:padding="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/_80sdp">

                <ImageView
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_hadith"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:contentDescription="الاحاديث" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الاحاديث"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/azkarFragment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selected_nav_background"
                android:padding="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/_80sdp">

                <ImageView
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_azkar"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:contentDescription="الاذكار" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الاذكار"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/quranFragment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/selected_nav_background"
                android:padding="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/_80sdp">

                <ImageView
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_quran"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:contentDescription="القرآن" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="القرآن"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>