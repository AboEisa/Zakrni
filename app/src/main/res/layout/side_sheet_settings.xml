<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Dim Background -->
    <View
        android:id="@+id/dimBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dialog_scrim" />

    <!-- Side Sheet Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/sideSheetCard"
        android:layout_width="@dimen/_280sdp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:cardCornerRadius="0dp"
        app:cardElevation="@dimen/_8sdp"
        app:cardBackgroundColor="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?android:attr/colorBackground">

            <!-- Header with Quran Icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:background="@color/side_sheet_header"
                android:padding="@dimen/_16sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_localized_056"
                    android:textColor="@color/side_sheet_header_text"
                    android:textSize="@dimen/_18sdp"
                    android:textStyle="bold"
                    android:layout_marginEnd="@dimen/_12sdp" />

                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/ic_quran"
                    android:background="@drawable/circle_gold_bg"
                    android:padding="@dimen/_8sdp" />

            </LinearLayout>

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="@dimen/_12sdp"
                android:background="@color/side_sheet_header">

                <TextView
                    android:id="@+id/tabFavorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/layout_localized_060"
                    android:textColor="@color/side_sheet_header_text"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:padding="@dimen/_8sdp"
                    android:background="@drawable/tab_unselected_bg" />

                <TextView
                    android:id="@+id/tabSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/layout_localized_034"
                    android:textColor="@color/side_sheet_header"
                    android:textSize="@dimen/_12sdp"
                    android:gravity="center"
                    android:padding="@dimen/_8sdp"
                    android:background="@drawable/tab_selected_bg"
                    android:layout_marginStart="@dimen/_8sdp" />

            </LinearLayout>

            <!-- Settings List -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_8sdp">

                    <!-- القرآن الكريم -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_056"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:src="@drawable/ic_quran"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorPrimary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginHorizontal="@dimen/_12sdp" />

                    <!-- التفسير -->
                    <LinearLayout
                        android:id="@+id/menuTafsir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_038"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_menu_item"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <!-- الأجزاء -->
                    <LinearLayout
                        android:id="@+id/menuAjzaa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_021"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_menu_item"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <!-- الأحزاب -->
                    <LinearLayout
                        android:id="@+id/menuAhzab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_023"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_menu_item"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <!-- السجدات -->
                    <LinearLayout
                        android:id="@+id/menuSajdat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_045"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_menu_item"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <!-- الركوع -->
                    <LinearLayout
                        android:id="@+id/menuRukoo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_043"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_menu_item"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginVertical="@dimen/_8sdp" />

                    <!-- الصفحة الرئيسية -->
                    <LinearLayout
                        android:id="@+id/menuHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_047"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_home"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginVertical="@dimen/_8sdp" />

                    <!-- تفعيل الوضع الليلي -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/_12sdp">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchDarkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/switch_thumb_selector" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_072"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:id="@+id/darkModeIcon"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_dark_mode"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginVertical="@dimen/_8sdp" />

                    <!-- المزيد من التطبيقات -->
                    <LinearLayout
                        android:id="@+id/menuMoreApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_057"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_apps"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                    <!-- مشاركة التطبيق -->
                    <LinearLayout
                        android:id="@+id/btnShareApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:padding="@dimen/_12sdp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_localized_111"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="@dimen/_14sdp" />

                        <ImageView
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_share"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:tint="?android:attr/textColorSecondary" />

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Close Button at Bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start"
                android:padding="@dimen/_16sdp"
                android:background="?android:attr/colorBackground">

                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:src="@drawable/ic_arrow_forward"
                    android:padding="@dimen/_8sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?android:attr/textColorPrimary" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
