<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E8F4FD"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with hadith number and book info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/hadithNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="حديث رقم 1"
                android:textSize="12sp"
                android:textColor="#666666"
                 />

            <TextView
                android:id="@+id/bookInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صحيح البخاري - المجلد 1"
                android:textSize="12sp"
                android:textColor="#666666"
                />

        </LinearLayout>

        <!-- Hadith heading -->
        <TextView
            android:id="@+id/hadithHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="باب بدء الوحي"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"

            android:layout_marginBottom="8dp"
            android:gravity="end"
            android:visibility="gone" />

        <!-- Narrator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عن "
                android:textSize="14sp"
                android:textColor="#4A4A4A"
                />

            <TextView
                android:id="@+id/narrator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="عمر بن الخطاب رضي الله عنه"
                android:textSize="14sp"
                android:textColor="#4A4A4A"

                android:gravity="end" />

        </LinearLayout>

        <!-- Hadith Arabic text -->
        <TextView
            android:id="@+id/hadithArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إنما الأعمال بالنيات وإنما لكل امرئ ما نوى"
            android:textSize="18sp"
            android:textColor="#1A1A1A"
            android:lineSpacingExtra="8dp"
            android:gravity="end"
            android:layout_marginBottom="12dp"

            android:padding="12dp" />

        <!-- Chapter info -->
        <TextView
            android:id="@+id/chapterInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الباب 1"
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>