<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8sdp"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="@dimen/_4sdp"
    android:background="#FEFBF4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <!-- Book Name and Chapter Number Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/tv_book_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:textColor="#2C5530"
                tools:text="صحيح البخاري" />

            <TextView
                android:id="@+id/tv_chapter_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12ssp"
                android:textColor="#666666"
                android:layout_marginStart="@dimen/_8sdp"
                tools:text="Chapter: 1" />

        </LinearLayout>

        <!-- Hadith Number -->
        <TextView
            android:id="@+id/tv_hadith_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_12ssp"
            android:textColor="#666666"
            android:layout_marginBottom="@dimen/_8sdp"
            tools:text="Hadith: 1" />

        <!-- Headings Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/tv_heading_arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                android:textColor="#2C5530"
                android:textAlignment="textEnd"
                android:layout_marginBottom="@dimen/_4sdp"
                tools:text="باب النية" />

            <TextView
                android:id="@+id/tv_heading_urdu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_13ssp"
                android:textColor="#2C5530"
                android:textAlignment="textEnd"
                android:layout_marginBottom="@dimen/_4sdp"
                tools:text="نیت کا باب" />

            <TextView
                android:id="@+id/tv_heading_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_13ssp"
                android:textColor="#2C5530"
                android:layout_marginBottom="@dimen/_4sdp"
                tools:text="Chapter on Intention" />

        </LinearLayout>

        <!-- Hadith Text Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/tv_hadith_arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_16ssp"
                android:textColor="#1A1A1A"
                android:lineSpacingExtra="@dimen/_4sdp"
                android:textAlignment="textEnd"
                android:layout_marginBottom="@dimen/_8sdp"
                tools:text="إنما الأعمال بالنيات وإنما لكل امرئ ما نوى" />

            <TextView
                android:id="@+id/tv_hadith_urdu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_14ssp"
                android:textColor="#333333"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:textAlignment="textEnd"
                android:layout_marginBottom="@dimen/_8sdp"
                tools:text="اعمال کا دارومدار نیتوں پر ہے" />

            <TextView
                android:id="@+id/tv_hadith_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_14ssp"
                android:textColor="#333333"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                tools:text="Actions are judged by intentions, and everyone will get what was intended." />

        </LinearLayout>

        <!-- Narrator Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_urdu_narrator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12ssp"
                android:textColor="#666666"
                android:textStyle="italic"
                android:textAlignment="textEnd"
                android:layout_marginBottom="@dimen/_2sdp"
                tools:text="عمر بن خطاب رضی اللہ عنہ" />

            <TextView
                android:id="@+id/tv_english_narrator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12ssp"
                android:textColor="#666666"
                android:textStyle="italic"
                tools:text="Umar ibn al-Khattab (RA)" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>