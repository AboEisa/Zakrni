<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Number Circle -->
        <androidx.cardview.widget.CardView
            android:id="@+id/numberCard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/quran_header"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/prayer_text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="1" />

        </androidx.cardview.widget.CardView>

        <!-- Arabic Name -->
        <TextView
            android:id="@+id/tvArabicName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/layout_localized_044"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_brown"
            android:gravity="end"
            app:layout_constraintStart_toEndOf="@+id/numberCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Transliteration -->
        <TextView
            android:id="@+id/tvTransliteration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:text="Ar-Rahman"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:textStyle="italic"
            android:gravity="end"
            app:layout_constraintStart_toEndOf="@+id/numberCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvArabicName" />

        <!-- Meaning -->
        <TextView
            android:id="@+id/tvMeaning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="The Most Gracious"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="end"
            app:layout_constraintStart_toEndOf="@+id/numberCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTransliteration"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Divider Line -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:background="@color/divider"
            app:layout_constraintStart_toEndOf="@+id/numberCard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>