<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mushaf_page_color"
    android:layoutDirection="ltr">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_mushaf_header"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/surah_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/layout_localized_090"
                android:textSize="20sp"
                android:textColor="@color/quran_header_text"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Surah Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/surah_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/layout_localized_115"
                android:textSize="14sp"
                android:textColor="@color/player_text_secondary"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/verses_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/layout_localized_002"
                android:textSize="14sp"
                android:textColor="@color/player_text_secondary" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══ Beautiful Loading State ═══ -->
    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@id/audio_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingBottom="24dp">

                <!-- Top ornamental divider -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_ornamental_divider" />

                <!-- Surah badge placeholder -->
                <View
                    android:layout_width="140dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_surah_name_badge"
                    android:alpha="0.4" />

                <!-- Bismillah placeholder -->
                <View
                    android:layout_width="220dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_shimmer_line" />

                <!-- Divider placeholder -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_ornamental_divider"
                    android:alpha="0.4" />

                <!-- Mushaf frame with shimmer lines -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/mushaf_page_color">

                    <LinearLayout
                        android:id="@+id/shimmer_lines_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_mushaf_frame"
                        android:padding="20dp"
                        android:gravity="center_horizontal">

                        <!-- Shimmer text lines (simulate Quran text) -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <View
                            android:layout_width="280dp"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <View
                            android:layout_width="240dp"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line_short" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <View
                            android:layout_width="200dp"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line_short" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <View
                            android:layout_width="260dp"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <!-- Loading indicator in the middle -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp">

                            <ProgressBar
                                android:id="@+id/loading_spinner"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:indeterminateTint="@color/traditional_gold" />

                            <TextView
                                android:id="@+id/loading_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/layout_localized_078"
                                android:textSize="14sp"
                                android:textColor="@color/text_tertiary"
                                android:layout_marginTop="12dp"
                                android:fontFamily="serif" />

                        </LinearLayout>

                        <!-- More shimmer lines below -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <View
                            android:layout_width="220dp"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line_short" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/bg_shimmer_line" />

                        <View
                            android:layout_width="180dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_shimmer_line_short" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Bottom ornamental divider -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ornamental_divider"
                    android:alpha="0.4" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Old progress bar kept for reference (hidden) -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@id/audio_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mushaf-style Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mushaf_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@id/audio_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Ornamental top divider -->
            <View
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ornamental_divider" />

            <!-- ❖ Surah Name Badge -->
            <LinearLayout
                android:id="@+id/surah_badge_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_surah_name_badge"
                android:paddingHorizontal="24dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❖"
                    android:textSize="14sp"
                    android:textColor="@color/islamic_gold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/surah_badge_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_localized_090"
                    android:textSize="16sp"
                    android:textColor="@color/prayer_text_white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❖"
                    android:textSize="14sp"
                    android:textColor="@color/islamic_gold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Bismillah -->
            <TextView
                android:id="@+id/bismillah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_localized_065"
                android:textSize="22sp"
                android:textColor="@color/bismillah_color"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:fontFamily="serif"
                android:layoutDirection="ltr" />

            <!-- Ornamental divider below bismillah -->
            <View
                android:id="@+id/divider_below_bismillah"
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_ornamental_divider" />

            <!-- ﷽ Mushaf Frame with Quran Text -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/mushaf_page_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_mushaf_frame"
                    android:padding="20dp">

                    <!-- Flowing Quran Text (like real Mushaf) -->
                    <TextView
                        android:id="@+id/mushaf_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textColor="@color/text_dark"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:layoutDirection="ltr"
                        android:fontFamily="serif"
                        android:lineSpacingMultiplier="1.8"
                        android:textIsSelectable="true"
                        tools:text="بسم الله الرحمن الرحيم ﴿١﴾ الحمد لله رب العالمين ﴿٢﴾" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Surah info footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/surah_info_juz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/surah_info_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary" />

            </LinearLayout>

            <!-- Bottom ornamental divider -->
            <View
                android:layout_width="200dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_ornamental_divider" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Keep existing RecyclerView hidden (for audio adapter reference) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quran_verses_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintBottom_toTopOf="@id/audio_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Enhanced Audio Player Controls -->
    <LinearLayout
        android:id="@+id/audio_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_audio_player"
        android:elevation="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="12dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="38dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle_bar"
            android:alpha="0.7"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_player_mini_chip">

                <ImageButton
                    android:id="@+id/repeat_button"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_repeat"
                    android:padding="7dp"
                    android:contentDescription="Repeat"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/repeat_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:textColor="@color/prayer_text_white_e6"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp"
                />

            <LinearLayout
                android:id="@+id/reciter_selector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"
                android:background="@drawable/bg_player_chip"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_reciter"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/reciter_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/layout_localized_112"
                    android:textColor="@color/prayer_text_white_f6"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_down"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <SeekBar
            android:id="@+id/audio_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/player_progress"
            android:progressBackgroundTint="@color/player_progress_track"
            android:thumbTint="@color/player_thumb"
            android:max="100"
            android:progress="0"
            android:splitTrack="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/player_text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/player_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/previous_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_control_button"
                android:src="@drawable/ic_skip_previous"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Previous"
                app:tint="@color/white" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/play_button"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_play_button"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Play"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:elevation="4dp"
                app:tint="@color/white" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/next_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_control_button"
                android:src="@drawable/ic_skip_next"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Next"
                app:tint="@color/white" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
