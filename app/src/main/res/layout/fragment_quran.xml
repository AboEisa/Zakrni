<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:name="com.example.zakrni.clean.views.QuranFragment"
    android:background="#F8F9FA">

    <!-- Surah Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/surah_header_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/surah_header_gradient">

            <!-- Bismillah -->
            <TextView
                android:id="@+id/bismillah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بِسْمِ اللّهِ الرَّحْمـَنِ الرَّحِيمِ"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:fontFamily="@font/scheherazade"
                android:layout_marginBottom="8dp"
                android:visibility="visible" />

            <!-- Surah Name -->
            <TextView
                android:id="@+id/surah_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="سُورَةُ ٱلْفَاتِحَةِ"
                android:textSize="24sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:fontFamily="@font/scheherazade"
                android:textStyle="bold" />

            <!-- Surah Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/surah_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مكية"
                    android:textSize="14sp"
                    android:textColor="#E8F5E8"
                    android:fontFamily="@font/scheherazade"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/verses_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 آيات"
                    android:textSize="14sp"
                    android:textColor="#E8F5E8"
                    android:fontFamily="@font/scheherazade" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- RecyclerView for Verses -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quran_verses_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/surah_header_card"
        app:layout_constraintBottom_toTopOf="@id/audio_player_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="8dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_quran" />

    <!-- Audio Player at the Bottom -->
    <androidx.cardview.widget.CardView
        android:id="@+id/audio_player_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/audio_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Reciter Image -->
            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/reciter_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_profile"
                    android:scaleType="centerCrop" />

            </androidx.cardview.widget.CardView>

            <!-- Reciter Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reciter_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الشيخ ماهر المعيقلي"
                    android:textSize="10sp"
                    android:textColor="@android:color/black"
                    android:fontFamily="@font/scheherazade"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/current_verse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الآية 1"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/scheherazade" />

            </LinearLayout>

            <!-- Control Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Previous Button -->
                <ImageButton
                    android:id="@+id/previous_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_skip_previous"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Previous Verse" />

                <!-- Play/Pause Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#2E7D32"
                    android:layout_marginEnd="8dp">

                    <ImageButton
                        android:id="@+id/play_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_play"
                        android:background="?attr/selectableItemBackgroundBorderless"

                        android:contentDescription="Play/Pause" />

                </androidx.cardview.widget.CardView>

                <!-- Next Button -->
                <ImageButton
                    android:id="@+id/next_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_skip_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Next Verse" />

                <!-- Share Button -->
                <ImageButton
                    android:id="@+id/share_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Share" />

                <!-- Bookmark Button -->
                <ImageButton
                    android:id="@+id/bookmark_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_bookmark"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Bookmark" />

            </LinearLayout>

        </LinearLayout>

        <!-- Progress Bar (Hidden by default) -->
        <ProgressBar
            android:id="@+id/audio_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:progressTint="#2E7D32"
            android:visibility="gone" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>