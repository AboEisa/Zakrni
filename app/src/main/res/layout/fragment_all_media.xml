<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".clean.ui.views.AllMediaFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_20sdp">

            <LinearLayout
                android:id="@+id/articlesFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/green_card_background"
                android:padding="@dimen/_6sdp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="المقالات"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="قم بتصفح المقالات الدينية من هنا"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:alpha="0.9"

                    />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/audiosFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/black_card_background"
                android:padding="@dimen/_6sdp"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="@dimen/_8sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="الصوتيات"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="استمع الي المساند والمحاضرات الصوتية من هنا"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:alpha="0.9"
                    />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/videosFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/brown_card_background"
                android:padding="@dimen/_6sdp"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="@dimen/_8sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="الفيديوهات"
                    android:textColor="@color/white"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="عرض الفيديوهات الدينية من هنا"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:alpha="0.9"
                     />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sermonsFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/purple_card_background"
                android:padding="@dimen/_6sdp"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginTop="@dimen/_8sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="الخطب"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="شاهد الخطب الدينية كلها من هنا"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:alpha="0.9"
                    />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>