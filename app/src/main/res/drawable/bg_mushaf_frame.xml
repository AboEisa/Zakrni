<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer gold border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#D4AF37" />
            <corners android:radius="8dp" />
            <solid android:color="@color/mushaf_page_color" />
        </shape>
    </item>
    <!-- Inner border with margin -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#C9A227" />
            <corners android:radius="4dp" />
            <solid android:color="@color/mushaf_page_color" />
        </shape>
    </item>
</layer-list>
