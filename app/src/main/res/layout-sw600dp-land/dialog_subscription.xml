<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/dialog_bg">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_star"
        app:tint="@color/brand_gold" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/layout_localized_087"
        android:textColor="@color/dialog_title_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/layout_localized_016"
        android:textColor="@color/dialog_body_text"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Features List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_localized_121"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_localized_123"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_localized_122"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_localized_079"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_localized_109"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/layout_localized_007"
            android:textColor="@color/dialog_button_text"
            android:textSize="14sp"
            app:backgroundTint="@color/dialog_button_primary"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Buttons Container (shown when products loaded) -->
    <LinearLayout
        android:id="@+id/buttonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Monthly Subscription Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMonthlySubscription"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/layout_localized_019"
            android:textColor="@color/dialog_button_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/dialog_button_primary"
            app:cornerRadius="12dp"
            android:layout_marginBottom="10dp" />

        <!-- Yearly Subscription Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYearlySubscription"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/layout_localized_018"
            android:textColor="@color/dialog_button_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/dialog_button_primary"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Cancel / Later -->
    <TextView
        android:id="@+id/btnLater"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/layout_localized_107"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="16dp" />

</LinearLayout>
